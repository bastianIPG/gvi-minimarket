        overflow: visible;
        padding: 0;
        flex: 1 1 auto;
        min-width: 0;
    }

    .topbar-nav-pill {
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: stretch;
        gap: 0;
        padding: 0;
        border-radius: 0;
        background: transparent;
        position: relative;
        margin: 0 auto;
        overflow: visible;
        width: fit-content;
        flex: 0 1 auto;
        min-width: max-content;
    }

    body.dark-mode .topbar-nav-pill {
        background: transparent;
    }

    .topbar-actions {
