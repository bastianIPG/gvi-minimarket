    }

    .topbar-brand {
        min-height: 34px;
        padding: 0;
        background: transparent;
        color: #fff;
        cursor: default;
        gap: 10px;
    }

    body.dark-mode .topbar-brand {
        background: transparent;
        color: #fff;
    }

    .brand-logo {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        object-fit: contain;
        display: block;
        flex: 0 0 auto;
    }

    .brand-text {
