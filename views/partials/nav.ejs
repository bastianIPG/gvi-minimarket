        align-items: center;
        justify-content: flex-end;
        gap: 7px;
        flex: 0 0 auto;
        min-width: 0;
    }

    .topbar-link {
        min-height: 56px;
        padding: 0 15px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.75);
        position: relative;
        z-index: 1;
        font-weight: 800;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
    }

    .topbar-nav-pill .topbar-link svg {
        display: none;
    }

    body.dark-mode .topbar-link { color: rgba(255, 255, 255, 0.75); }

    .topbar-link.active {
        color: white;
        background: transparent;
        box-shadow: none;
    }

    .topbar-nav-pill .topbar-link::after {
        content: "";
