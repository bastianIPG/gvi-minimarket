<nav class="app-topbar" id="appTopbar">
    <div class="app-topbar-left">
        <div class="topbar-brand" title="GVI">
            <img src="/img/gvi-logo.png" alt="" class="brand-logo">
            <span class="brand-text">GVI</span>
        </div>
    </div>

    <div class="topbar-links">
        <div class="topbar-nav-pill">
            <a href="/" class="topbar-link" data-label="Inicio"><i data-lucide="home"></i><span>Inicio</span></a>
            <a href="/caja" class="topbar-link" data-label="Ventas"><i data-lucide="shopping-cart"></i><span>Ventas</span></a>
            <a href="/productos" class="topbar-link" data-label="Productos"><i data-lucide="scan-barcode"></i><span>Productos</span></a>
            <a href="/bodega" class="topbar-link" data-label="Bodega"><i data-lucide="package"></i><span>Bodega</span></a>
            <a href="/finanzas" class="topbar-link admin-only" data-label="Finanzas"><i data-lucide="bar-chart-3"></i><span>Finanzas</span></a>
            <a href="/finanzas#reportes" class="topbar-link admin-only" data-label="Reportes"><i data-lucide="file-bar-chart"></i><span>Reportes</span></a>
            <a href="/configuracion" class="topbar-link admin-only" data-label="Configuracion"><i data-lucide="settings"></i><span>Configuracion</span></a>
        </div>
        <div class="topbar-actions">
            <button class="topbar-window-btn notification-toggle" onclick="toggleNotificaciones(event)" title="Notificaciones" data-label="Notificaciones">
                <i data-lucide="bell"></i>
            <span class="notification-dot" id="notificationDot" hidden></span>
            </button>
            <a href="#" onclick="togglePerfil(event)" class="topbar-link user-switch" data-label="Perfil"><i data-lucide="user"></i><span id="topbarUserName">Usuario</span></a>
            <div class="topbar-window-group" aria-label="Controles de ventana">
                <button class="topbar-window-btn minimize" onclick="minimizarAppNav()" title="Minimizar GVI" data-label="Minimizar"><i data-lucide="minus"></i></button>
                <button class="topbar-window-btn danger" onclick="cerrarProgramaNav()" title="Cerrar programa" data-label="Cerrar"><i data-lucide="power"></i></button>
            </div>
        </div>
    </div>
</nav>

<div class="notifications-popover" id="notificationsPopover">
    <div class="notifications-header">
        <strong>Notificaciones</strong>
        <span>Centro GVI</span>
    </div>
    <div class="notification-item update" id="notificationUpdateItem" hidden>
        <i data-lucide="download-cloud" id="notificationUpdateIcon"></i>
        <div>
            <strong id="notificationUpdateTitle">Actualizaciones</strong>
            <span id="notificationUpdateText">GVI revisa nuevas versiones en segundo plano.</span>
            <div class="notification-progress" id="notificationUpdateProgress">
                <div id="notificationUpdateProgressBar"></div>
            </div>
            <div class="notification-actions" id="notificationUpdateActions" hidden>
                <button class="notification-action" id="notificationUpdatePrimary" type="button">Descargar</button>
                <button class="notification-action secondary" id="notificationUpdateSecondary" type="button">Ahora no</button>
            </div>
        </div>
    </div>
    <div class="notification-item" id="notificationInstalledNotice" hidden>
        <i data-lucide="sparkles"></i>
        <div>
            <strong id="notificationInstalledTitle">GVI actualizado</strong>
            <span id="notificationInstalledText">La nueva version se instalo correctamente.</span>
            <button class="notification-action secondary" type="button" onclick="descartarAvisoActualizacion(event)">Entendido</button>
        </div>
    </div>
    <div class="notifications-empty" id="notificationsEmpty">No hay notificaciones por ahora.</div>
</div>

<div class="profile-popover" id="profilePopover">
    <div class="profile-avatar" id="profileAvatar">U</div>
    <div class="profile-meta">
        <strong id="profileName">Usuario</strong>
        <span id="profileRole">Perfil activo</span>
    </div>
    <button type="button" class="profile-switch-btn" onclick="cambiarUsuario(event)">
        <i data-lucide="repeat-2"></i>
        Cambiar usuario
    </button>
    <button type="button" class="profile-logout-btn" onclick="cerrarSesion(event)">
        <i data-lucide="log-out"></i>
        Cerrar sesion
    </button>
</div>

<div class="update-installed-toast" id="updateInstalledToast" hidden>
    <div>
        <strong id="updateInstalledToastTitle">GVI actualizado</strong>
        <span id="updateInstalledToastText">La nueva version se instalo correctamente.</span>
    </div>
    <button type="button" onclick="abrirNovedadesActualizacion(event)">Ver mejoras</button>
    <button type="button" class="toast-close" onclick="descartarAvisoActualizacion(event)" title="Cerrar"><i data-lucide="x"></i></button>
</div>

<script>
    function cerrarSesion(e) {
        if (e) e.preventDefault();
        if (confirm('Cerrar sesion actual?')) {
            localStorage.removeItem('gvi_user');
            window.location.href = '/login';
        }
    }

    function claveRutaNav(valor) {
        try {
            const url = new URL(valor || window.location.href, window.location.origin);
            return `${url.pathname}${url.hash || ''}`;
        } catch (_) {
            return valor || '';
        }
    }

    function indiceRutaNav(valor) {
        const clave = claveRutaNav(valor);
        const sinHash = clave.split('#')[0];
        const links = Array.from(document.querySelectorAll('.topbar-nav-pill .topbar-link'))
            .filter(link => {
                const href = link.getAttribute('href');
                return href && href !== '#';
            });

        const exacto = links.findIndex(link => claveRutaNav(link.getAttribute('href')) === clave);
        if (exacto >= 0) return exacto;
        return links.findIndex(link => claveRutaNav(link.getAttribute('href')).split('#')[0] === sinHash);
    }

    function direccionRutaNav(destino) {
        const actual = `${window.location.pathname}${window.location.hash || ''}`;
        const desde = indiceRutaNav(actual);
        const hacia = indiceRutaNav(destino);
        if (desde < 0 || hacia < 0 || desde === hacia) return 'neutral';
        return hacia > desde ? 'right' : 'left';
    }

    function prepararCambioRuta(destino) {
        const direccion = direccionRutaNav(destino);
        try {
            sessionStorage.setItem('gvi_previous_route', `${window.location.pathname}${window.location.hash || ''}`);
            sessionStorage.setItem('gvi_next_route', claveRutaNav(destino));
            sessionStorage.setItem('gvi_route_direction', direccion);
            sessionStorage.setItem('gvi_route_cover', '1');
        } catch (_) {}
        document.body.dataset.routeDestino = destino || '';
        document.body.dataset.routeDirection = direccion;
        document.documentElement.dataset.routeDirection = direccion;
        document.documentElement.classList.add('gvi-route-leaving');
        if (typeof window.gviMotionPrepareRoute === 'function') {
            window.gviMotionPrepareRoute(destino, direccion);
        }
        document.body.classList.add('is-routing');
    }

    function navegarConMovimiento(destino) {
        prepararCambioRuta(destino);
        setTimeout(() => { window.location.href = destino; }, 165);
    }

    function togglePerfil(e) {
        if (e) e.preventDefault();
        const popover = document.getElementById('profilePopover');
        if (typeof window.gviMotionCloseNotifications === 'function') {
            window.gviMotionCloseNotifications();
        } else {
            document.getElementById('notificationsPopover')?.classList.remove('open');
        }
        popover?.classList.toggle('open');
    }

    function toggleNotificaciones(e) {
        if (e) e.preventDefault();
        const popover = document.getElementById('notificationsPopover');
        document.getElementById('profilePopover')?.classList.remove('open');
        if (typeof window.gviMotionToggleNotifications === 'function') {
            window.gviMotionToggleNotifications();
        } else {
            popover?.classList.toggle('open');
        }
        consultarActualizacionNav();
        consultarAvisoActualizacionNav();
    }

    function normalizarTextoActualizacion(texto) {
        return String(texto || '').replace(/<[^>]*>/g, '').trim();
    }

    function updateNotificationKey(kind, version) {
        return `gvi_update_notification_${kind}_${version || 'actual'}`;
    }

    function estaNotificacionPospuesta(kind, version) {
        return localStorage.getItem(updateNotificationKey(kind, version)) === 'later';
    }

    function posponerNotificacionActualizacion(kind, version) {
        localStorage.setItem(updateNotificationKey(kind, version), 'later');
        aplicarVisibilidadNotificaciones();
    }

    function aplicarVisibilidadNotificaciones() {
        const popover = document.getElementById('notificationsPopover');
        const items = popover ? Array.from(popover.querySelectorAll('.notification-item')) : [];
        const visibleItems = items.filter(item => !item.hidden);
        const empty = document.getElementById('notificationsEmpty');
        const dot = document.getElementById('notificationDot');
        if (empty) empty.hidden = visibleItems.length > 0;
        if (dot) dot.hidden = visibleItems.length === 0;
        if (typeof window.gviMotionPositionNotifications === 'function') {
            window.gviMotionPositionNotifications();
        }
    }

    async function descargarActualizacionNav(e) {
        if (e) e.preventDefault();
        const primary = document.getElementById('notificationUpdatePrimary');
        if (primary) {
            primary.disabled = true;
            primary.innerText = 'Descargando...';
        }
        try {
            const res = await fetch('/api/app/update/download', { method: 'POST' });
            const data = await res.json();
            aplicarActualizacionNav(data);
        } catch (_) {
            if (primary) {
                primary.disabled = false;
                primary.innerText = 'Descargar';
            }
        }
    }

    async function instalarActualizacionNav(e) {
        if (e) e.preventDefault();
        const primary = document.getElementById('notificationUpdatePrimary');
        if (primary) {
            primary.disabled = true;
            primary.innerText = 'Instalando...';
        }
        try {
            await fetch('/api/app/update/install', { method: 'POST' });
        } catch (_) {
            if (primary) {
                primary.disabled = false;
                primary.innerText = 'Instalar ahora';
            }
        }
    }

    async function descartarAvisoActualizacion(e) {
        if (e) e.preventDefault();
        document.getElementById('notificationInstalledNotice')?.setAttribute('hidden', '');
        document.getElementById('updateInstalledToast')?.setAttribute('hidden', '');
        aplicarVisibilidadNotificaciones();
        await fetch('/api/app/update/notice/dismiss', { method: 'POST' }).catch(() => null);
    }

    function abrirNovedadesActualizacion(e) {
        if (e) e.preventDefault();
        document.getElementById('profilePopover')?.classList.remove('open');
        if (typeof window.gviMotionOpenNotifications === 'function') {
            window.gviMotionOpenNotifications();
        } else {
            document.getElementById('notificationsPopover')?.classList.add('open');
        }
    }

    function aplicarActualizacionNav(data) {
        const title = document.getElementById('notificationUpdateTitle');
        const text = document.getElementById('notificationUpdateText');
        const progress = document.getElementById('notificationUpdateProgress');
        const bar = document.getElementById('notificationUpdateProgressBar');
        const item = document.getElementById('notificationUpdateItem');
        const actions = document.getElementById('notificationUpdateActions');
        const primary = document.getElementById('notificationUpdatePrimary');
        const secondary = document.getElementById('notificationUpdateSecondary');
        const icon = document.getElementById('notificationUpdateIcon');
        if (!title || !text || !progress || !bar || !item || !actions || !primary || !secondary) return;

        item.hidden = true;
        actions.hidden = true;
        primary.disabled = false;
        secondary.disabled = false;
        progress.classList.remove('visible');
        bar.style.width = '0%';
        if (icon) icon.setAttribute('data-lucide', 'download-cloud');

        if (!data.configured) {
            aplicarVisibilidadNotificaciones();
            return;
        }

        if (data.installing) {
            item.hidden = false;
            title.innerText = 'Actualizando GVI';
            text.innerText = 'Instalando en silencio. La app se reiniciara automaticamente.';
            if (icon) icon.setAttribute('data-lucide', 'loader-circle');
            aplicarVisibilidadNotificaciones();
            return;
        }

        if (data.downloading) {
            item.hidden = false;
            title.innerText = `Descargando v${data.version || ''}`;
            text.innerText = data.message || 'Descarga en segundo plano. Puedes seguir usando GVI.';
            progress.classList.add('visible');
            bar.style.width = `${data.percent || 0}%`;
            if (icon) icon.setAttribute('data-lucide', 'download');
            aplicarVisibilidadNotificaciones();
            return;
        }

        if (data.ready) {
            if (estaNotificacionPospuesta('ready', data.version)) {
                aplicarVisibilidadNotificaciones();
                return;
            }
            item.hidden = false;
            title.innerText = `Actualizacion v${data.version} lista`;
            text.innerText = 'La descarga termino. Puedes instalarla ahora o recordarlo mas tarde.';
            actions.hidden = false;
            primary.innerText = 'Instalar ahora';
            primary.onclick = instalarActualizacionNav;
            secondary.innerText = 'Recordar mas tarde';
            secondary.onclick = (event) => {
                if (event) event.preventDefault();
                posponerNotificacionActualizacion('ready', data.version);
            };
            if (icon) icon.setAttribute('data-lucide', 'refresh-cw');
            aplicarVisibilidadNotificaciones();
            return;
        }

        if (data.checking) {
            aplicarVisibilidadNotificaciones();
            return;
        }

        if (data.available) {
            if (estaNotificacionPospuesta('available', data.version)) {
                aplicarVisibilidadNotificaciones();
                return;
            }
            item.hidden = false;
            title.innerText = `Nueva version v${data.version}`;
            text.innerText = 'Hay una actualizacion disponible. Quieres descargarla ahora?';
            actions.hidden = false;
            primary.innerText = 'Descargar';
            primary.onclick = descargarActualizacionNav;
            secondary.innerText = 'Ahora no';
            secondary.onclick = (event) => {
                if (event) event.preventDefault();
                posponerNotificacionActualizacion('available', data.version);
            };
            if (icon) icon.setAttribute('data-lucide', 'download-cloud');
        }
        aplicarVisibilidadNotificaciones();
    }

    async function consultarActualizacionNav() {
        try {
            const res = await fetch('/api/app/update/status');
            const data = await res.json();
            aplicarActualizacionNav(data);
            if (typeof lucide !== 'undefined') lucide.createIcons();
        } catch (_) {}
    }

    async function consultarAvisoActualizacionNav() {
        try {
            const res = await fetch('/api/app/update/notice');
            const data = await res.json();
            const notice = data.notice;
            const item = document.getElementById('notificationInstalledNotice');
            if (!item) return;
            if (!notice) {
                item.hidden = true;
                document.getElementById('updateInstalledToast')?.setAttribute('hidden', '');
                aplicarVisibilidadNotificaciones();
                return;
            }
            item.hidden = false;
            const notes = normalizarTextoActualizacion(notice.releaseNotes) || 'Actualizacion aplicada correctamente.';
            document.getElementById('notificationInstalledTitle').innerText = `GVI v${notice.version} instalado`;
            document.getElementById('notificationInstalledText').innerText = notes;
            const toast = document.getElementById('updateInstalledToast');
            if (toast) {
                toast.hidden = false;
                document.getElementById('updateInstalledToastTitle').innerText = `GVI v${notice.version} instalado`;
                document.getElementById('updateInstalledToastText').innerText = notes.slice(0, 110);
            }
            aplicarVisibilidadNotificaciones();
        } catch (_) {}
    }

    function actualizarTemaNav() {
        const icon = document.getElementById('themeToggleIcon');
        const esOscuro = typeof gviApplyTheme === 'function' ? gviApplyTheme() : document.body.classList.contains('dark-mode');
        if (icon) icon.setAttribute('data-lucide', esOscuro ? 'sun' : 'moon');
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function toggleTemaNav() {
        const esOscuro = document.body.classList.contains('dark-mode');
        if (typeof gviSetThemePreference === 'function') {
            gviSetThemePreference(esOscuro ? 'claro' : 'oscuro');
        } else {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('temaGVI', document.body.classList.contains('dark-mode') ? 'oscuro' : 'claro');
        }
        actualizarTemaNav();
    }

    function cambiarUsuario(e) {
        if (e) e.preventDefault();
        document.getElementById('profilePopover')?.classList.remove('open');
        localStorage.removeItem('gvi_user');
        window.location.href = '/login';
    }

    async function minimizarAppNav() {
        await fetch('/api/app/minimize', { method: 'POST' });
    }

    async function cerrarProgramaNav() {
        if (!confirm('Cerrar GVI por completo?')) return;
        localStorage.removeItem('gvi_user');
        await fetch('/api/app/quit', { method: 'POST' });
    }

    document.addEventListener('DOMContentLoaded', () => {
        try {
            if (typeof gviApplyTheme === 'function') gviApplyTheme();
            actualizarTemaNav();

            const usrInfo = JSON.parse(localStorage.getItem('gvi_user'));
            if (usrInfo?.nombre) {
                const userName = document.getElementById('topbarUserName');
                if (userName) userName.innerText = usrInfo.nombre;
                const profileName = document.getElementById('profileName');
                const profileRole = document.getElementById('profileRole');
                const profileAvatar = document.getElementById('profileAvatar');
                if (profileName) profileName.innerText = usrInfo.nombre;
                if (profileRole) profileRole.innerText = usrInfo.rol || 'Perfil activo';
                if (profileAvatar) profileAvatar.innerText = usrInfo.nombre.trim().charAt(0).toUpperCase();
            }
            if (usrInfo && usrInfo.rol !== 'ADMIN') {
                document.querySelectorAll('.admin-only').forEach(el => el.style.display = 'none');
            }
        } catch (e) {}

        const path = window.location.pathname;

        const activeLink = Array.from(document.querySelectorAll('.topbar-link')).find(link => link.getAttribute('href') === path);
        if (activeLink) {
            activeLink.classList.add('active');
        }

        document.querySelectorAll('.topbar-link').forEach(link => {
            const href = link.getAttribute('href');
            if (!href || href === '#' || href === path) return;
            link.addEventListener('click', (event) => {
                document.querySelectorAll('.topbar-link').forEach(item => item.classList.remove('active'));
                link.classList.add('active');
                event.preventDefault();
                navegarConMovimiento(href);
            });
        });

        document.querySelectorAll('a[href^="/"]').forEach(link => {
            if (link.classList.contains('topbar-link')) return;
            link.addEventListener('click', (event) => {
                const href = link.getAttribute('href');
                if (!href || href === path) return;
                event.preventDefault();
                navegarConMovimiento(href);
            });
        });

        document.addEventListener('click', (event) => {
            const popover = document.getElementById('profilePopover');
            const notifications = document.getElementById('notificationsPopover');
            const userButton = document.querySelector('.topbar-link.user-switch');
            const notificationButton = document.querySelector('.notification-toggle');
            if (popover?.classList.contains('open') && !popover.contains(event.target) && !userButton?.contains(event.target)) {
                popover.classList.remove('open');
            }
            if (notifications?.classList.contains('open') && !notifications.contains(event.target) && !notificationButton?.contains(event.target)) {
                if (typeof window.gviMotionCloseNotifications === 'function') {
                    window.gviMotionCloseNotifications();
                } else {
                    notifications.classList.remove('open');
                }
            }
        });

        consultarActualizacionNav();
        consultarAvisoActualizacionNav();
        setInterval(consultarActualizacionNav, 3500);

        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>

<style>
    .app-topbar {
        width: 100%;
        margin: 0 auto;
        padding: 0 14px;
        min-height: 56px;
        border-radius: 0;
        background: #0b1728;
        border: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.18);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        z-index: 1800;
        color: rgba(255, 255, 255, 0.86);
    }

    body.dark-mode .app-topbar {
        background: #0b1728;
        border-bottom-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
    }

    .app-topbar-left {
        display: flex;
        align-items: center;
        gap: 0;
        flex: 0 0 142px;
        min-width: 142px;
    }

    .topbar-icon-btn,
    .topbar-window-btn,
    .topbar-link,
    .topbar-brand {
        min-height: 34px;
        border-radius: 999px;
        border: none;
        text-decoration: none;
        color: inherit;
