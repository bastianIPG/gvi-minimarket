        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
    }

    .topbar-icon-btn,
    .topbar-window-btn {
        width: 34px;
        padding: 0;
        background: transparent;
        cursor: pointer;
        flex: 0 0 auto;
        color: rgba(255, 255, 255, 0.82);
        border-radius: 8px;
    }

    body.dark-mode .topbar-icon-btn,
    body.dark-mode .topbar-window-btn {
        background: transparent;
        color: rgba(255, 255, 255, 0.82);
    }

    .topbar-icon-btn:hover,
    .topbar-window-btn:hover,
    .topbar-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
    }

    body.dark-mode .topbar-icon-btn:hover,
    body.dark-mode .topbar-window-btn:hover,
