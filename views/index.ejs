<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>GVI - Inicio</title>
    <style>
        html,
        body {
            min-height: 100%;
        }

        body {
            background: #eef2f7;
            color: var(--texto-claro);
            overflow: hidden;
        }

        body.dark-mode {
            background: #10151f;
        }

        .home-dashboard {
            width: calc(100% - 32px);
            margin: 0 auto;
            padding: 10px 0 12px;
            height: calc(100vh - 56px);
            box-sizing: border-box;
            display: flex;
        }

        .home-board {
            overflow: hidden;
            border: 1px solid rgba(36, 47, 70, 0.12);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 20px 48px rgba(15, 23, 42, 0.12);
            flex: 1 1 auto;
            min-height: 0;
            display: grid;
            grid-template-rows: minmax(208px, 0.9fr) auto minmax(205px, 1fr);
        }

        body.dark-mode .home-board {
            background: rgba(19, 24, 34, 0.98);
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 22px 52px rgba(0, 0, 0, 0.3);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.75fr) minmax(300px, 0.95fr);
            border-bottom: 1px solid rgba(36, 47, 70, 0.1);
        }

        .hero-sales,
        .hero-stats,
        .hero-alerts {
            min-height: 208px;
        }

        .hero-sales {
            padding: 24px 34px 22px;
            display: grid;
            align-content: center;
        }

        .hero-stats,
        .hero-alerts {
            border-left: 1px solid rgba(36, 47, 70, 0.1);
        }

        body.dark-mode .hero-grid,
        body.dark-mode .hero-stats,
        body.dark-mode .hero-alerts {
            border-color: rgba(255, 255, 255, 0.08);
        }

        .metric-label {
            margin: 0 0 12px;
            color: #182033;
            font-size: 17px;
            font-weight: 900;
        }

        body.dark-mode .metric-label {
            color: #fff;
        }

        .sales-total {
            margin: 0;
            color: var(--azul-gvi);
            font-size: clamp(48px, 5.7vw, 72px);
            font-weight: 900;
            letter-spacing: -0.035em;
            line-height: 0.96;
        }

        .sales-trend {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-top: 18px;
            color: #28a955;
            font-size: 15px;
            font-weight: 900;
        }

        .sales-trend svg {
            width: 18px;
            height: 18px;
            stroke-width: 2.5px;
        }

        .sales-trend span {
            color: #667085;
            font-weight: 800;
        }

        body.dark-mode .sales-trend span {
            color: rgba(246, 247, 251, 0.58);
        }

        .stat-row,
        .critical-row {
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr);
            gap: 14px;
            align-items: center;
            min-height: 69px;
            padding: 13px 24px;
            border-bottom: 1px solid rgba(36, 47, 70, 0.1);
        }

        .stat-row:last-child,
        .critical-row:last-child {
            border-bottom: 0;
        }

        body.dark-mode .stat-row,
        body.dark-mode .critical-row {
            border-color: rgba(255, 255, 255, 0.08);
        }

        .stat-icon,
        .critical-icon,
        .action-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: rgba(61, 115, 255, 0.1);
            color: #64748b;
            flex: 0 0 auto;
        }

        .stat-icon svg,
        .critical-icon svg,
        .action-icon svg {
            width: 19px;
            height: 19px;
            stroke-width: 2.3px;
        }

        .stat-row span,
        .critical-row span {
            display: block;
            color: #667085;
            font-size: 13px;
            font-weight: 800;
        }

        body.dark-mode .stat-row span,
        body.dark-mode .critical-row span {
            color: rgba(246, 247, 251, 0.56);
        }

        .stat-row strong,
        .critical-row strong {
            display: block;
            margin-top: 4px;
            color: #182033;
            font-size: 20px;
            font-weight: 900;
            line-height: 1.05;
        }

        body.dark-mode .stat-row strong,
        body.dark-mode .critical-row strong {
            color: #fff;
        }

        .critical-row.warning .critical-icon {
            background: rgba(255, 59, 48, 0.08);
            color: #ff4d4f;
        }

        .critical-row.pending .critical-icon {
            background: rgba(255, 149, 0, 0.1);
            color: #ff9500;
        }

        .critical-row a {
            display: inline-block;
            margin-top: 5px;
            color: var(--azul-gvi);
            font-size: 13px;
            font-weight: 900;
            text-decoration: none;
        }

        .section-block {
            padding: 14px 24px 16px;
            border-bottom: 1px solid rgba(36, 47, 70, 0.1);
        }

        body.dark-mode .section-block {
            border-color: rgba(255, 255, 255, 0.08);
        }

        .section-title {
            margin: 0 0 9px;
            color: #1d2939;
            font-size: 15px;
            font-weight: 900;
        }

        body.dark-mode .section-title {
            color: #fff;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(5, minmax(130px, 1fr));
            gap: 12px;
        }

        .quick-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-height: 40px;
            padding: 0 14px;
            border: 1px solid rgba(36, 47, 70, 0.14);
            border-radius: 7px;
            background: #fff;
            color: #344054;
            font-size: 13px;
            font-weight: 900;
            text-decoration: none;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            transition: transform 0.14s ease, border-color 0.14s ease, background-color 0.14s ease;
        }

        .quick-action.primary {
            background: var(--azul-gvi);
            border-color: var(--azul-gvi);
            color: #fff;
            box-shadow: 0 8px 18px rgba(61, 115, 255, 0.22);
        }

        .quick-action:hover {
            transform: translateY(-1px);
            border-color: rgba(61, 115, 255, 0.42);
        }

        body.dark-mode .quick-action {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            color: rgba(246, 247, 251, 0.86);
        }

        body.dark-mode .quick-action.primary {
            background: var(--azul-gvi);
            border-color: var(--azul-gvi);
            color: #fff;
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.95fr);
            gap: 16px;
            padding: 16px 24px 18px;
            min-height: 0;
        }

        .home-panel {
            min-height: 0;
            border: 1px solid rgba(36, 47, 70, 0.1);
            border-radius: 8px;
            background: #fff;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        body.dark-mode .home-panel {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 22px 10px;
        }

        .panel-header h2 {
            margin: 0;
            color: #182033;
            font-size: 17px;
            font-weight: 900;
        }

        body.dark-mode .panel-header h2 {
            color: #fff;
        }

        .panel-link {
            color: var(--azul-gvi);
            font-size: 13px;
            font-weight: 900;
            text-decoration: none;
        }

        .sales-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .sales-table th {
            padding: 10px 18px;
            border-top: 1px solid rgba(36, 47, 70, 0.08);
            border-bottom: 1px solid rgba(36, 47, 70, 0.08);
            color: #667085;
            font-size: 12px;
            font-weight: 900;
            text-align: left;
        }

        .sales-table td {
            padding: 10px 18px;
            border-bottom: 1px solid rgba(36, 47, 70, 0.07);
            color: #344054;
            font-weight: 800;
        }

        body.dark-mode .sales-table th,
        body.dark-mode .sales-table td {
            border-color: rgba(255, 255, 255, 0.07);
        }

        body.dark-mode .sales-table td {
            color: rgba(246, 247, 251, 0.82);
        }

        .status-badge {
            color: #28a955;
            font-size: 12px;
            font-weight: 900;
        }

        .alerts-list {
            display: grid;
            gap: 0;
            padding: 0 22px 10px;
            align-content: start;
            flex: 1 1 auto;
        }

        .recent-alert {
            display: grid;
            grid-template-columns: 12px minmax(0, 1fr) auto;
            gap: 12px;
            align-items: center;
            min-height: 43px;
            border-top: 1px solid rgba(36, 47, 70, 0.07);
            color: #344054;
            font-size: 13px;
            font-weight: 850;
        }

        .recent-alert:first-child {
            border-top: 0;
        }

        body.dark-mode .recent-alert {
            border-color: rgba(255, 255, 255, 0.07);
            color: rgba(246, 247, 251, 0.82);
        }

        .alert-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--azul-gvi);
        }

        .alert-dot.danger { background: #ff3b30; }
        .alert-dot.warning { background: #ff9500; }
        .alert-dot.info { background: var(--azul-gvi); }
        .alert-dot.success { background: #28c76f; }

        .recent-alert time {
            color: #667085;
            font-size: 12px;
            font-weight: 800;
        }

        body.dark-mode .recent-alert time {
            color: rgba(246, 247, 251, 0.5);
        }

        .empty-state {
            padding: 30px 20px;
            color: #667085;
            font-size: 13px;
            font-weight: 850;
            text-align: center;
        }

        .sales-table .empty-state {
            height: 100%;
        }

        @media (max-width: 980px) {
            .hero-grid,
            .content-grid {
                grid-template-columns: 1fr;
            }

            .hero-stats,
            .hero-alerts {
                border-left: 0;
                border-top: 1px solid rgba(36, 47, 70, 0.1);
            }

            .quick-actions {
                grid-template-columns: repeat(2, minmax(150px, 1fr));
            }
        }

        @media (max-width: 760px) {
            .home-dashboard {
                width: min(100% - 20px, 1440px);
                padding-top: 10px;
                height: auto;
                min-height: calc(100vh - 56px);
                overflow: visible;
                display: block;
            }

            .home-board {
                display: block;
                min-height: 0;
            }

            .hero-sales,
            .section-block,
            .content-grid {
                padding-left: 16px;
                padding-right: 16px;
            }

            .quick-actions {
                grid-template-columns: 1fr;
            }

            .sales-table {
                min-width: 640px;
            }

            .home-panel {
                overflow-x: auto;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="home-dashboard">
        <section class="home-board" aria-label="Panel principal GVI">
            <div class="hero-grid">
                <article class="hero-sales">
                    <p class="metric-label">Ventas hoy</p>
                    <h1 class="sales-total" id="metricVentas">$0</h1>
                    <div class="sales-trend" id="metricTrend">
                        <i data-lucide="trending-up"></i>
                        <strong>0%</strong>
                        <span>vs ayer</span>
                    </div>
                </article>

                <div class="hero-stats">
                    <div class="stat-row">
                        <div class="stat-icon"><i data-lucide="receipt-text"></i></div>
                        <div>
                            <span>Transacciones</span>
                            <strong id="statTransacciones">0</strong>
                        </div>
                    </div>
                    <div class="stat-row">
                        <div class="stat-icon"><i data-lucide="message-square-text"></i></div>
                        <div>
                            <span>Ticket promedio</span>
                            <strong id="metricTicket">$0</strong>
                        </div>
                    </div>
                    <div class="stat-row">
                        <div class="stat-icon"><i data-lucide="users"></i></div>
                        <div>
                            <span>Clientes hoy</span>
                            <strong id="statClientes">0</strong>
                        </div>
                    </div>
                </div>

                <div class="hero-alerts">
                    <div class="critical-row warning">
                        <div class="critical-icon"><i data-lucide="bell-ring"></i></div>
                        <div>
                            <span>Stock critico</span>
                            <strong><span id="stockCriticalCount">0</span> productos</strong>
                            <a href="/bodega">Ver lista</a>
                        </div>
                    </div>
                    <div class="critical-row pending">
                        <div class="critical-icon"><i data-lucide="circle-dollar-sign"></i></div>
                        <div>
                            <span>Pedidos pendientes</span>
                            <strong><span id="pedidosPendingCount">0</span> por cobrar</strong>
                            <a href="/cobrar">Ver pedidos</a>
                        </div>
                    </div>
                </div>
            </div>

            <section class="section-block" aria-label="Acciones rapidas">
                <h2 class="section-title">Acciones rapidas</h2>
                <div class="quick-actions">
                    <a href="/caja" class="quick-action primary"><i data-lucide="plus"></i>Nueva venta</a>
                    <a href="/cobrar" class="quick-action"><i data-lucide="user-round-check"></i>Cobrar pedidos</a>
                    <a href="/productos" class="quick-action"><i data-lucide="package"></i>Productos</a>
                    <a href="/bodega" class="quick-action"><i data-lucide="archive"></i>Bodega</a>
                    <a href="/finanzas" class="quick-action admin-only"><i data-lucide="file-bar-chart"></i>Reportes</a>
                </div>
            </section>

            <section class="content-grid">
                <article class="home-panel">
                    <div class="panel-header">
                        <h2>Ultimas ventas</h2>
                        <a href="/finanzas" class="panel-link admin-only">Ver todas las ventas</a>
                    </div>
                    <table class="sales-table" aria-label="Ultimas ventas">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Hora</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Pago</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody id="ventasRecientes">
                            <tr><td colspan="6" class="empty-state">Cargando ultimas ventas...</td></tr>
                        </tbody>
                    </table>
                </article>

                <article class="home-panel">
                    <div class="panel-header">
                        <h2>Alertas recientes</h2>
                    </div>
                    <div class="alerts-list" id="alertasRecientes">
                        <div class="empty-state">Cargando alertas...</div>
                    </div>
                    <div class="panel-header">
                        <a href="/bodega" class="panel-link">Ver todas las alertas</a>
                    </div>
                </article>
            </section>
        </section>
    </main>

    <%- include('partials/scripts') %>

    <script>
        const money = new Intl.NumberFormat('es-CL', {
            style: 'currency',
            currency: 'CLP',
            maximumFractionDigits: 0
        });

        function formatoMonto(valor) {
            return money.format(Number(valor) || 0);
        }

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, char => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[char]));
        }

        function fechaCL(offsetDias = 0) {
            const fecha = new Date();
            fecha.setDate(fecha.getDate() + offsetDias);
            return fecha.toLocaleDateString('es-CL');
        }

        function esFechaHoy(fecha) {
            return fecha === fechaCL(0);
        }

        function esFechaAyer(fecha) {
            return fecha === fechaCL(-1);
        }

        async function cargarDashboardOperativo() {
            try {
                const [productosRes, ventasRes, pedidosRes] = await Promise.all([
                    fetch('/api/productos'),
                    fetch('/api/ventas'),
                    fetch('/api/pedidos')
                ]);

                const productos = await productosRes.json();
                const ventas = await ventasRes.json();
                const pedidos = await pedidosRes.json();

                const ventasHoy = ventas.filter(v => esFechaHoy(v.fecha));
                const ventasAyer = ventas.filter(v => esFechaAyer(v.fecha));
                const totalHoy = ventasHoy.reduce((sum, v) => sum + Number(v.total || 0), 0);
                const totalAyer = ventasAyer.reduce((sum, v) => sum + Number(v.total || 0), 0);
                const ticketPromedio = ventasHoy.length ? totalHoy / ventasHoy.length : 0;
                const clientesHoy = new Set(ventasHoy.map(v => v.cliente || 'Publico general')).size;
                const stockCritico = productos.filter(p => Number(p.stock || 0) <= 5);
                const sinStock = productos.filter(p => Number(p.stock || 0) <= 0);
                const tendencia = totalAyer > 0 ? ((totalHoy - totalAyer) / totalAyer) * 100 : 0;

                document.getElementById('metricVentas').innerText = formatoMonto(totalHoy);
                document.getElementById('statTransacciones').innerText = ventasHoy.length;
                document.getElementById('metricTicket').innerText = formatoMonto(ticketPromedio);
                document.getElementById('statClientes').innerText = clientesHoy;
                document.getElementById('stockCriticalCount').innerText = stockCritico.length;
                document.getElementById('pedidosPendingCount').innerText = pedidos.length;
                renderTendencia(tendencia, totalAyer);
                renderVentasRecientes(ventas.slice(0, 3));
                renderAlertasRecientes({ stockCritico, sinStock, pedidos, ventasHoy });
                if (typeof lucide !== 'undefined') lucide.createIcons();
            } catch (error) {
                console.error('Error cargando dashboard', error);
                document.getElementById('ventasRecientes').innerHTML = '<tr><td colspan="6" class="empty-state">No se pudieron cargar las ventas.</td></tr>';
                document.getElementById('alertasRecientes').innerHTML = '<div class="empty-state">No se pudieron cargar las alertas.</div>';
            }
        }

        function renderTendencia(tendencia, totalAyer) {
            const contenedor = document.getElementById('metricTrend');
            const valor = totalAyer > 0 ? `${tendencia >= 0 ? '+' : ''}${tendencia.toFixed(1)}%` : '0%';
            contenedor.style.color = tendencia < 0 ? '#ff3b30' : '#28a955';
            contenedor.innerHTML = `
                <i data-lucide="${tendencia < 0 ? 'trending-down' : 'trending-up'}"></i>
                <strong>${valor}</strong>
                <span>vs ayer</span>
            `;
        }

        function renderVentasRecientes(ventas) {
            const contenedor = document.getElementById('ventasRecientes');
            if (!ventas.length) {
                contenedor.innerHTML = '<tr><td colspan="6" class="empty-state">Aun no hay ventas registradas.</td></tr>';
                return;
            }

            contenedor.innerHTML = ventas.map(v => `
                <tr>
                    <td>${String(v.id).padStart(6, '0')}</td>
                    <td>${escapeHtml((v.hora || '--').slice(0, 5))}</td>
                    <td>${escapeHtml(v.cliente || 'Publico general')}</td>
                    <td>${formatoMonto(v.total)}</td>
                    <td>${escapeHtml(v.metodoPago || 'Venta')}</td>
                    <td><span class="status-badge">Completada</span></td>
                </tr>
            `).join('');
        }

        function renderAlertasRecientes({ stockCritico, sinStock, pedidos, ventasHoy }) {
            const alertas = [];
            if (sinStock.length) {
                alertas.push({
                    tipo: 'danger',
                    titulo: `${sinStock.length} producto${sinStock.length === 1 ? '' : 's'} sin stock`,
                    tiempo: 'Ahora'
                });
            }

            if (stockCritico.length) {
                const muestra = stockCritico[0]?.nombre ? `${stockCritico[0].nombre} - ` : '';
                alertas.push({
                    tipo: 'danger',
                    titulo: `${muestra}Stock critico`,
                    tiempo: 'Hace 10 min'
                });
            }

            if (pedidos.length) {
                alertas.push({
                    tipo: 'warning',
                    titulo: `Pedido #${String(pedidos[0]?.id || '00045').padStart(5, '0')} pendiente de cobro`,
                    tiempo: 'Hace 25 min'
                });
            }

            alertas.push({
                tipo: 'info',
                titulo: 'Actualizacion disponible',
                tiempo: 'Hace 1 h'
            });

            if (!ventasHoy.length && !stockCritico.length && !pedidos.length) {
                alertas.unshift({
                    tipo: 'success',
                    titulo: 'Sistema listo para comenzar ventas',
                    tiempo: 'Hoy'
                });
            }

            document.getElementById('alertasRecientes').innerHTML = alertas.slice(0, 4).map(alerta => `
                <div class="recent-alert">
                    <span class="alert-dot ${alerta.tipo}"></span>
                    <strong>${escapeHtml(alerta.titulo)}</strong>
                    <time>${escapeHtml(alerta.tiempo)}</time>
                </div>
            `).join('');
        }

        function cargarDatosUsuario() {
            try {
                const usrInfo = JSON.parse(localStorage.getItem('gvi_user'));
                if (usrInfo && usrInfo.rol !== 'ADMIN') {
                    document.querySelectorAll('.admin-only').forEach(el => el.style.display = 'none');
                }
            } catch (e) {}
        }

        document.addEventListener('DOMContentLoaded', () => {
            cargarDatosUsuario();
            cargarDashboardOperativo();
            setInterval(cargarDashboardOperativo, 5000);
            if (typeof lucide !== 'undefined') lucide.createIcons();
        });
    </script>
</body>
</html>
