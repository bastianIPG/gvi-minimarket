<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>GVI - Punto de Venta</title>
    <style>
        @font-face {
            font-family: 'Inter GVI';
            src: url('/fonts/Inter-900.ttf') format('truetype');
            font-weight: 900;
            font-style: normal;
            font-display: swap;
        }

        .caja-header { display: flex; justify-content: space-between; align-items: center; margin-top: 40px; margin-bottom: 20px; }
        .caja-header h1 { font-size: 32px; margin: 0; display: flex; align-items: center; gap: 10px; }
        
        .caja-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; align-items: start; }

        .panel-ticket { background: var(--panel-claro); border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); overflow: hidden; display: flex; flex-direction: column; min-height: 65vh; }
        body.dark-mode .panel-ticket { background: var(--panel-oscuro); }
        
        .buscador-caja { padding: 20px; background: rgba(0,0,0,0.02); border-bottom: 1px solid #eee; display: flex; gap: 15px; position: relative; }
        body.dark-mode .buscador-caja { background: rgba(255,255,255,0.02); border-bottom-color: #333; }
        .input-barras { flex: 1; padding: 15px; font-size: 18px; border-radius: 10px; border: 2px solid var(--azul-gvi); outline: none; background: transparent; color: inherit; font-family: monospace; }
        
        /* --- ESTILOS SUGERENCIAS --- */
        .sugerencias-busqueda {
            position: absolute;
            top: 100%; left: 20px; right: 20px;
            background: var(--panel-claro);
            border: 1px solid #ddd;
            border-radius: 0 0 10px 10px;
            z-index: 1000;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-height: 280px;
            overflow-y: auto;
            display: none;
        }
        body.dark-mode .sugerencias-busqueda { background: #252525; border-color: #444; }
        .sugerencia-item {
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }
        body.dark-mode .sugerencia-item { border-bottom-color: #333; }
        .sugerencia-item:hover { background: rgba(0,122,255,0.1); }
        .sugerencia-item b { color: var(--azul-gvi); }

        table { width: 100%; border-collapse: collapse; text-align: left; }
        th, td { padding: 15px 20px; border-bottom: 1px solid #eee; }
        body.dark-mode th, body.dark-mode td { border-bottom-color: #333; }
        th { background: rgba(0,0,0,0.02); font-weight: 600; color: #666; text-transform: uppercase; font-size: 12px; }
        
        .control-cant { display: flex; align-items: center; gap: 10px; }
        .btn-cant { background: #eee; border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: background-color 0.14s ease, color 0.14s ease; }
        body.dark-mode .btn-cant { background: #444; color: white; }

        .panel-cobro { background: var(--panel-claro); border-radius: 15px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); position: sticky; top: 20px; }
        body.dark-mode .panel-cobro { background: var(--panel-oscuro); }
        
        .caja-total { font-family: 'Inter GVI', "Segoe UI Variable Display", "Segoe UI", system-ui, sans-serif; font-size: 55px; font-weight: 900; color: var(--azul-gvi); margin: 10px 0 20px; text-align: center; }
        
        .btn-cobrar { width: 100%; background: #34c759; color: white; border: none; padding: 20px; font-size: 22px; font-weight: bold; border-radius: 12px; cursor: pointer; transition: background-color 0.16s ease, opacity 0.16s ease; }
        .btn-cobrar:disabled { background: #ccc; opacity: 0.5; cursor: not-allowed; }

        .metodos-pago-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 25px 0; }
        .btn-metodo { padding: 15px 10px; border-radius: 12px; border: 2px solid #eee; background: transparent; cursor: pointer; font-weight: 800; font-size: 14px; color: inherit; transition: border-color 0.14s ease, background-color 0.14s ease, color 0.14s ease; }
        body.dark-mode .btn-metodo { border-color: #333; }
        .btn-metodo.activo { border-color: var(--azul-gvi); background: rgba(0, 122, 255, 0.1); color: var(--azul-gvi); }
        .badge-peso { display: inline-block; background: rgba(255,149,0,0.15); color: #ff9500; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 20px; margin-left: 6px; vertical-align: middle; }

        .badge-precio-carrito {
            display: inline-flex;
            align-items: center;
            margin-left: 6px;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
            vertical-align: middle;
        }

        .badge-precio-oferta { background: rgba(255,59,48,0.1); color: #ff3b30; }
        .badge-precio-mayor { background: rgba(0,122,255,0.1); color: var(--azul-gvi); }

        .precio-editable {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 800;
        }

        .btn-editar-precio {
            width: 28px;
            height: 28px;
            border: none;
            border-radius: 8px;
            background: rgba(0, 122, 255, 0.1);
            color: var(--azul-gvi);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            transition: background-color 0.14s ease, color 0.14s ease;
        }

        .btn-editar-precio:hover {
            background: var(--azul-gvi);
            color: white;
        }

        .modal-precio-panel {
            width: min(430px, calc(100vw - 32px));
            padding: 0;
            overflow: hidden;
            border-radius: 22px;
        }

        .modal-precio-header {
            padding: 22px 24px 18px;
            background: linear-gradient(135deg, rgba(0,122,255,0.12), rgba(52,199,89,0.08));
            border-bottom: 1px solid rgba(0,0,0,0.06);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        body.dark-mode .modal-precio-header { border-bottom-color: #333; }

        .modal-precio-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: var(--azul-gvi);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            box-shadow: 0 6px 14px rgba(0,122,255,0.24);
        }

        .modal-precio-icon svg { width: 24px; height: 24px; }

        .modal-precio-title h3 {
            margin: 0;
            font-size: 22px;
            line-height: 1.1;
        }

        .modal-precio-title span {
            display: block;
            margin-top: 5px;
            font-size: 12px;
            font-weight: 800;
            opacity: 0.55;
            text-transform: uppercase;
        }

        .modal-precio-body { padding: 22px 24px 24px; }

        .producto-precio-card {
            background: rgba(0,122,255,0.06);
            border: 1px solid rgba(0,122,255,0.12);
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 18px;
        }

        body.dark-mode .producto-precio-card {
            background: rgba(0,122,255,0.1);
            border-color: rgba(255,255,255,0.08);
        }

        .producto-precio-card span {
            display: block;
            font-size: 11px;
            font-weight: 900;
            opacity: 0.55;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .producto-precio-card b {
            display: block;
            font-size: 16px;
            line-height: 1.25;
        }

        .precio-field {
            margin-bottom: 14px;
        }

        .precio-field label {
            display: block;
            margin-bottom: 7px;
            font-size: 12px;
            font-weight: 900;
            opacity: 0.65;
            text-transform: uppercase;
        }

        .precio-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .precio-input-wrap i,
        .precio-input-wrap svg {
            position: absolute;
            left: 14px;
            width: 19px;
            height: 19px;
            color: var(--azul-gvi);
            opacity: 0.75;
        }

        .precio-input-wrap .form-input {
            padding-left: 44px !important;
            min-height: 54px;
            border-radius: 14px;
        }

        #editarPrecioPin {
            letter-spacing: 7px;
            text-align: center;
        }

        #editarPrecioValor {
            color: var(--azul-gvi);
            font-size: 25px;
            font-weight: 900;
            text-align: center;
        }

        .modal-precio-actions {
            display: grid;
            grid-template-columns: 0.9fr 1.2fr;
            gap: 10px;
            margin-top: 8px;
        }

        .modal-cobro-panel,
        .modal-manual-panel {
            width: min(620px, calc(100vw - 32px));
            padding: 0;
            overflow: hidden;
            border-radius: 26px;
            text-align: left;
            border: 1px solid rgba(255,255,255,0.7);
            box-shadow: 0 34px 90px rgba(25, 35, 58, 0.26);
        }

        body.dark-mode .modal-cobro-panel,
        body.dark-mode .modal-manual-panel {
            border-color: rgba(255,255,255,0.08);
            box-shadow: 0 34px 90px rgba(0,0,0,0.42);
        }

        @keyframes cobroPanelIn {
            from { opacity: 0; transform: translate3d(0, 14px, 0) scale(0.985); }
            to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
        }

        @keyframes boletaPreviewIn {
            from { opacity: 0; transform: translate3d(18px, 0, 0); }
            to { opacity: 1; transform: translate3d(0, 0, 0); }
        }

        .modal-cobro-panel {
            --modal-width: 1100px;
            width: min(1100px, calc(100vw - 48px)) !important;
            max-height: min(780px, calc(100vh - 48px)) !important;
            overflow: hidden !important;
            background: #fff;
            border-radius: 16px;
            border: 1px solid rgba(17,24,39,0.08);
            box-shadow: 0 30px 80px rgba(15,23,42,0.28);
            display: grid;
            grid-template-columns: minmax(0, 1fr) 360px;
            position: relative;
        }

        .modal-cobro-main {
            min-width: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(17,24,39,0.1);
        }

        #modalFinalizar {
            background: rgba(15,23,42,0.44);
            backdrop-filter: blur(5px);
        }

        #modalFinalizar.modal-visible .modal-cobro-panel {
            animation: cobroPanelIn 0.18s ease-out both;
        }

        #modalFinalizar.modal-visible .boleta-preview-card {
            animation: boletaPreviewIn 0.22s ease-out both;
        }

        .modal-cobro-header,
        .modal-manual-header {
            padding: 24px 28px 22px;
            background: #fff;
            border-bottom: 1px solid rgba(0,0,0,0.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        #modalFinalizar .modal-cobro-header {
            position: static;
            padding: 28px 58px 20px 28px;
            border-bottom: 1px solid rgba(17,24,39,0.08);
            flex: 0 0 auto;
        }

        .modal-cobro-close {
            position: absolute;
            right: 22px;
            top: 22px;
            width: 34px;
            height: 34px;
            border: 0;
            background: transparent;
            color: #64748b;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .modal-cobro-close:hover {
            background: rgba(15,23,42,0.06);
            color: #0f172a;
        }

        body.dark-mode .modal-cobro-header,
        body.dark-mode .modal-manual-header {
            background:
                radial-gradient(circle at 88% 0%, rgba(52,199,89,0.16), transparent 34%),
                linear-gradient(135deg, rgba(61,115,255,0.14), rgba(255,255,255,0.04));
            border-bottom-color: rgba(255,255,255,0.08);
        }

        .modal-kicker {
            display: block;
            font-size: 12px;
            font-weight: 900;
            opacity: 0.58;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 6px;
        }

        .modal-cobro-header h3,
        .modal-manual-header h3 {
            margin: 0;
            font-size: clamp(26px, 4vw, 34px);
            line-height: 1;
            letter-spacing: -0.03em;
        }

        .modal-cobro-meta,
        .modal-manual-meta {
            margin: 9px 0 0;
            color: var(--texto-suave);
            font-size: 14px;
            font-weight: 750;
        }

        .modal-icon-soft {
            width: 58px;
            height: 58px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--azul-gvi);
            background: rgba(255,255,255,0.72);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.9), 0 16px 34px rgba(61,115,255,0.18);
            flex: 0 0 auto;
        }

        body.dark-mode .modal-icon-soft {
            background: rgba(255,255,255,0.08);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 16px 34px rgba(0,0,0,0.2);
        }

        .modal-icon-soft svg {
            width: 28px;
            height: 28px;
        }

        .modal-cobro-total {
            min-width: 230px;
            font-size: clamp(44px, 5.2vw, 58px);
            line-height: 1;
            font-weight: 950;
            color: var(--azul-gvi);
            font-variant-numeric: tabular-nums;
            letter-spacing: 0;
            text-align: right;
        }

        .modal-cobro-total::before {
            content: "TOTAL A PAGAR";
            display: block;
            margin-bottom: 8px;
            color: #64748b;
            font-size: 12px;
            line-height: 1;
            font-weight: 950;
            letter-spacing: 0.1em;
        }

        .modal-cobro-body,
        .modal-manual-body {
            padding: 24px 28px 28px;
        }

        .modal-cobro-body {
            display: block;
            padding: 20px 28px 28px;
            min-height: 0;
            overflow: hidden;
            flex: 1 1 auto;
        }

        #modalFinalizar .modal-cobro-body {
            background: #fff;
        }

        .cobro-main-panel {
            min-width: 0;
        }

        .cobro-step-title {
            margin: 0 0 10px;
            color: #111827;
            font-size: 13px;
            font-weight: 950;
        }

        .metodos-cobro {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .metodos-cobro .btn-metodo {
            position: relative;
            min-height: 76px;
            padding: 12px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid rgba(17,24,39,0.08);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 11px;
            color: #111827;
            box-shadow: none;
            transition: transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease;
        }

        body.dark-mode #modalFinalizar .modal-cobro-panel,
        body.dark-mode #modalFinalizar .modal-cobro-header,
        body.dark-mode #modalFinalizar .modal-cobro-body,
        body.dark-mode #modalFinalizar .boleta-preview-card {
            background: #fff;
            color: #111827;
        }

        body.dark-mode #modalFinalizar .modal-cobro-meta,
        body.dark-mode #modalFinalizar .modal-kicker,
        body.dark-mode #modalFinalizar .cobro-step-title,
        body.dark-mode #modalFinalizar .boleta-preview-title,
        body.dark-mode #modalFinalizar .campo-pago-card label {
            color: #667085;
        }

        body.dark-mode #modalFinalizar .metodos-cobro .btn-metodo {
            background: #fff;
            color: #111827;
            border-color: rgba(17,24,39,0.1);
        }

        body.dark-mode #modalFinalizar .metodos-cobro .btn-metodo.activo {
            background: #f8fbff;
            border-color: rgba(61,115,255,0.58);
            color: var(--azul-gvi);
        }

        body.dark-mode #modalFinalizar .metodos-cobro .btn-metodo.transfer-color {
            color: #0a9f68;
            border-color: rgba(10,159,104,0.26);
        }

        body.dark-mode #modalFinalizar .metodos-cobro .btn-metodo.hybrid-color {
            color: #7c3aed;
            border-color: rgba(124,58,237,0.24);
        }

        .metodos-cobro .btn-metodo svg {
            width: 30px;
            height: 30px;
        }

        .metodos-cobro .btn-metodo span {
            font-size: 14px;
            font-weight: 850;
        }

        .metodos-cobro .btn-metodo:hover {
            transform: translateY(-1px);
            border-color: rgba(61,115,255,0.24);
        }

        .metodos-cobro .btn-metodo.activo {
            background: #f8fbff;
            border-color: rgba(61,115,255,0.58);
            color: var(--azul-gvi);
        }

        .metodos-cobro .btn-metodo.activo::after {
            content: "✓";
            position: absolute;
            top: 12px;
            right: 12px;
            width: 20px;
            height: 20px;
            border-radius: 999px;
            background: var(--azul-gvi);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 950;
        }

        body.dark-mode .metodos-cobro .btn-metodo {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.08);
            color: rgba(246,247,251,0.84);
        }

        .metodos-cobro .btn-metodo.transfer-color {
            color: #0a9f68;
            border-color: rgba(10,159,104,0.26);
        }

        .metodos-cobro .btn-metodo.transfer-color.activo {
            background: rgba(10,159,104,0.1);
            border-color: rgba(10,159,104,0.55);
        }

        .metodos-cobro .btn-metodo.hybrid-color {
            color: #7c3aed;
            border-color: rgba(124,58,237,0.24);
        }

        .metodos-cobro .btn-metodo.hybrid-color.activo {
            background: rgba(124,58,237,0.1);
            border-color: rgba(124,58,237,0.5);
        }

        #modalFinalizar .metodos-cobro .btn-metodo {
            background: #fff !important;
            color: #111827 !important;
            border-color: rgba(17,24,39,0.1) !important;
        }

        #modalFinalizar .metodos-cobro .btn-metodo.activo {
            background: #f8fbff !important;
            color: var(--azul-gvi) !important;
            border-color: rgba(61,115,255,0.58) !important;
        }

        #modalFinalizar .metodos-cobro .btn-metodo.transfer-color {
            color: #0a9f68 !important;
            border-color: rgba(10,159,104,0.26) !important;
        }

        #modalFinalizar .metodos-cobro .btn-metodo.transfer-color.activo {
            background: rgba(10,159,104,0.1) !important;
            border-color: rgba(10,159,104,0.55) !important;
        }

        #modalFinalizar .metodos-cobro .btn-metodo.hybrid-color {
            color: #7c3aed !important;
            border-color: rgba(124,58,237,0.24) !important;
        }

        #modalFinalizar .metodos-cobro .btn-metodo.hybrid-color.activo {
            background: rgba(124,58,237,0.1) !important;
            border-color: rgba(124,58,237,0.5) !important;
        }

        .campo-pago-card {
            background: #f7f9fd;
            border: 1px solid rgba(17,24,39,0.07);
            border-radius: 14px;
            padding: 12px 14px;
        }

        body.dark-mode .campo-pago-card {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.08);
        }

        .campo-pago-card label {
            display: block;
            margin-bottom: 10px;
            font-size: 12px;
            font-weight: 900;
            opacity: 0.62;
            text-transform: uppercase;
            letter-spacing: 0.07em;
        }

        .pago-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .pago-input-wrap i,
        .pago-input-wrap svg {
            position: absolute;
            left: 15px;
            width: 21px;
            height: 21px;
            color: var(--azul-gvi);
            opacity: 0.8;
        }

        .pago-input-wrap .form-input {
            min-height: 50px;
            padding: 0 20px 0 52px !important;
            border-radius: 12px;
            border: 2px solid rgba(61,115,255,0.2);
            background: #fff;
            font-size: clamp(22px, 3vw, 30px);
            font-weight: 950;
            text-align: center;
            color: var(--texto-oscuro);
            font-variant-numeric: tabular-nums;
            outline: none;
        }

        .pago-input-wrap .form-input:focus {
            border-color: rgba(61,115,255,0.8);
            box-shadow: 0 0 0 4px rgba(61,115,255,0.1);
        }

        body.dark-mode .pago-input-wrap .form-input {
            background: rgba(255,255,255,0.06);
            color: rgba(246,247,251,0.96);
        }

        .vuelto-card {
            margin-top: 10px;
            padding: 10px 14px;
            border-radius: 12px;
            background: rgba(52,199,89,0.12);
            color: #2eb84e;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 900;
            font-size: 22px;
            font-variant-numeric: tabular-nums;
        }

        .campo-pago-card + .campo-pago-card {
            margin-top: 10px;
        }

        .hibrido-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .hibrido-restante {
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: 12px;
            background: rgba(61,115,255,0.08);
            color: var(--azul-gvi);
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 900;
        }

        .boleta-preview-card {
            min-width: 0;
            border-radius: 0;
            border-top: 0;
            border-right: 0;
            border-bottom: 0;
            background: #fff;
            padding: 48px 28px 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 0;
        }

        .boleta-preview-title {
            width: 300px;
            display: none;
